<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="course/format/dari/db" VERSION="20260929" COMMENT="XMLDB file for AI Course Format chat history and memory">
  <TABLES>
    <TABLE NAME="format_dari_chats" COMMENT="Ask Dari questions and answers">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course ID"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User who asked the question"/>
        <FIELD NAME="activityid" TYPE="int" LENGTH="10" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="Activity ID if on activity page"/>
        <FIELD NAME="questionslot" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Quiz question slot number if on quiz"/>
        <FIELD NAME="question" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Question asked"/>
        <FIELD NAME="response" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="AI response"/>
        <FIELD NAME="rating" TYPE="int" LENGTH="2" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="User rating: 0=unrated, 1=helpful, -1=not helpful"/>
        <FIELD NAME="refused" TYPE="int" LENGTH="1" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="1 if AI refused to provide answer (academic integrity)"/>
        <FIELD NAME="locked" TYPE="int" LENGTH="1" NOTNULL="false" DEFAULT="0" SEQUENCE="false" COMMENT="1 if activity was locked (submitted)"/>
        <FIELD NAME="correction" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Correct answer provided by teacher"/>
        <FIELD NAME="correctedby" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="User who provided correction"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Timestamp when question was asked"/>
        <FIELD NAME="timecorrected" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Timestamp when correction was made"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="correctedby" TYPE="foreign" FIELDS="correctedby" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid_userid_idx" UNIQUE="false" FIELDS="courseid, userid" COMMENT="Course report student filter, and privacy export/delete by user within a course"/>
        <INDEX NAME="courseid_timecreated_idx" UNIQUE="false" FIELDS="courseid, timecreated" COMMENT="Course report listing, which is always courseid = ? ORDER BY timecreated DESC"/>
        <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="rating_idx" UNIQUE="false" FIELDS="rating"/>
        <INDEX NAME="activityid_idx" UNIQUE="false" FIELDS="activityid"/>
        <INDEX NAME="refused_idx" UNIQUE="false" FIELDS="refused"/>
        <INDEX NAME="questionslot_idx" UNIQUE="false" FIELDS="questionslot"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="format_dari_ai_memory" COMMENT="Per-activity AI memory for scaffolded tutoring">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course ID"/>
        <FIELD NAME="activityid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Activity ID"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User ID"/>
        <FIELD NAME="memory" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Summary of prior tutoring (topics, not answers)"/>
        <FIELD NAME="timeupdated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Last update timestamp"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="unique_memory" UNIQUE="true" FIELDS="courseid, activityid, userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="format_dari_actminutes" COMMENT="Per-activity estimated duration overrides set by a teacher">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Denormalised so a course purge is one delete"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="minutes" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="0 means hide the badge for this activity"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="cmid" UNIQUE="true" FIELDS="cmid"/>
        <INDEX NAME="courseid_cmid" UNIQUE="false" FIELDS="courseid, cmid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="format_dari_cardstyle" COMMENT="Per-card colour chosen by a teacher for section and activity cards">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Denormalised so a course purge is one delete"/>
        <FIELD NAME="targettype" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="section or cm"/>
        <FIELD NAME="targetid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="course_sections.id or course_modules.id"/>
        <FIELD NAME="colour" TYPE="char" LENGTH="7" NOTNULL="true" SEQUENCE="false" COMMENT="#rrggbb"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="targettype_targetid" UNIQUE="true" FIELDS="targettype, targetid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="format_dari_imageplan" COMMENT="Visual plan and image prompt per course image (course content only, no user data)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="itemkey" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="course, banner, section:{id} or cm:{id}"/>
        <FIELD NAME="factshash" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="sha1 of the facts the item was planned from"/>
        <FIELD NAME="teacherhash" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="sha1 of the teacher's own description the item was planned with, or empty"/>
        <FIELD NAME="plan" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="JSON plan item"/>
        <FIELD NAME="prompt" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Image prompt built from the plan, without the fixed tail"/>
        <FIELD NAME="attempts" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Image requests made for this item"/>
        <FIELD NAME="successes" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Images generated and stored"/>
        <FIELD NAME="failures" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Image requests that failed"/>
        <FIELD NAME="lastresult" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="success or failure"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid_itemkey" UNIQUE="true" FIELDS="courseid, itemkey"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="format_dari_imagelog" COMMENT="Timings and errors of AI image jobs, and browser errors on Dari pages; kept 30 days">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="itemkey" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="requestid" TYPE="char" LENGTH="36" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="stage" TYPE="char" LENGTH="30" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="ok" SEQUENCE="false"/>
        <FIELD NAME="durationms" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="message" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="courseid_time" UNIQUE="false" FIELDS="courseid, timecreated"/>
        <INDEX NAME="requestid" UNIQUE="false" FIELDS="requestid"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
